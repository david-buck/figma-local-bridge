# Canvas tools need no token or API key. The bridge binds only to your Mac's localhost.
FIGMA_BRIDGE_HOST=127.0.0.1
FIGMA_BRIDGE_PORT=3846
# Optional: defaults to ~/.figma-local-bridge
# FIGMA_PREFERENCES_DIR=/absolute/path/to/private/preferences-directory

# Optional: enable Figma comment tools through Figma's REST API.
# Create a personal access token with file_comments:read and, for posting or
# deleting comments, file_comments:write. Keep the token private.
# FIGMA_ACCESS_TOKEN=figd_...
# Optional default; callers may instead pass a Figma file URL or key per tool.
# FIGMA_FILE_KEY=your-file-key
